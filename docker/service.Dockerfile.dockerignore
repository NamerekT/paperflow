# Applies to docker/service.Dockerfile's build context, which is the repository root.
# Named after the Dockerfile on purpose: Docker reads <Dockerfile>.dockerignore next to
# the Dockerfile, or .dockerignore at the context root - a plain docker/.dockerignore is
# silently ignored. The context now travels over SSH to the server's daemon, so
# everything below would otherwise be uploaded on every deploy.

.git/
.claude/
.temp/

# The watcher's scans, logs and local state.
scans/
*.log
*.jsonl

# Diagnostic scripts and their data/output - not needed to run the service, and the
# data/results subfolders alone have run to tens of megabytes locally.
experiments/

# Real personal data and secrets - never belongs in a build context, let alone an image
# layer.
credentials/
family_members.json
.env
.env.*
!.env.example

# Python/tooling caches, never useful inside an image.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

tests/
