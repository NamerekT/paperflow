# Copy to .env and fill in. .env is gitignored and never committed.
# In the Docker container these come from docker-compose instead
# (env_file / environment), not from this file.

# ── Paperless-ngx ─────────────────────────────────────────────────────────
PAPERLESS_URL=https://paperless.example.ts.net
# Required, no default in code. Settings -> API Tokens in the Paperless UI.
PAPERLESS_API_TOKEN=

# ── LiteLLM proxy (vision OCR, orientation, classification, Frist) ────────
VISION_PROXY_URL=http://litellm.example.com
# Required, no default in code. The master key of the self-hosted proxy.
VISION_PROXY_KEY=
VISION_PROXY_MODEL=openrouter-gemma-4-31b-it

ORIENTATION_LLM_MODEL=google-gemini-3.5-flash-lite
FRIST_LLM_MODEL=google-gemini-3.5-flash-lite
CLASSIFIER_LLM_MODEL=google-gemini-3.6-flash
# prod | dev - dev bypasses the fallback chain and goes straight to the
# cheap model, so debugging runs do not burn the daily quota.
CLASSIFIER_ENV=prod

# ── Webhook service ───────────────────────────────────────────────────────
WEBHOOK_URL=http://localhost:8002/webhook/ocr-cascade
# Required for the service and for trigger_missing_cascade.py. Same value on
# both ends.
WEBHOOK_SHARED_SECRET=

# ── Google Tasks (Frist reminders) ────────────────────────────────────────
GOOGLE_TASKS_LIST_NAME=DocSorter Fristen
FRIST_CREATE_TASKS=false

# ── Paths ─────────────────────────────────────────────────────────────────
# Explicit rather than derived from where the package happens to be
# installed. In the container these are set by the Dockerfile and must match
# the compose volume mounts (/app/credentials, /app/family_members.json);
# deriving them from the package location silently repoints them when the
# code moves, and the only symptom is reminders quietly not being created.
PAPERFLOW_WATCH_FOLDER=
PAPERFLOW_CREDENTIALS_DIR=
PAPERFLOW_FAMILY_MEMBERS_FILE=
PAPERFLOW_LOG_FILE=

# ── Engine tuning ─────────────────────────────────────────────────────────
# One DPI for the whole pipeline. It used to be 300 at the call site and 200
# in the OCR engine's own default, so which one applied depended on the call.
PAPERFLOW_RENDER_DPI=300
PAPERFLOW_ESCALATE_MEAN=0.95
PAPERFLOW_ESCALATE_P10=0.95

# ru | en - applies to Windows notifications and CLI output only. Log records
# are always English.
PAPERFLOW_LOCALE=ru

# ── Diagnostic scripts in test/ only ──────────────────────────────────────
# Optional. Used by test/gemini_vision_ocr_test.py and test/vision_ocr_test.py
# when talking to those providers directly instead of through the proxy.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
